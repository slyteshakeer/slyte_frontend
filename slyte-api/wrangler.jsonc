{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slyte-api",
  "main": "src/index.js",
  "compatibility_date": "2024-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://slyte.in",
    "CASHFREE_ENV": "PRODUCTION"
  }
}
